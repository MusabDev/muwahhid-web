# Public origin of this site (canonical URLs, sitemap, feeds). Non-production origins are served with noindex.
VITE_SITE_URL=https://muwahhid.net
# Public Laravel API base, called from the browser.
VITE_API_URL=https://api.muwahhid.net/api
# Optional: private API address for server-side rendering (skips the public internet hop).
API_INTERNAL_URL=http://127.0.0.1:8000/api
# Optional: IndexNow key (must match INDEXNOW_KEY in the backend).
VITE_INDEXNOW_KEY=
